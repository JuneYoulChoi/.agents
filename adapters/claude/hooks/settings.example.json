{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "G=\"<harness-source>/adapters/claude/hooks/harness_guard.py\"; [ -f \"$G\" ] || exit 0; python3 -B \"$G\""
          }
        ]
      }
    ]
  }
}
